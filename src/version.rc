// The version resource TelemFFB reads from the installed plugin.

#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PANEL_VERSION_MAJOR,PANEL_VERSION_MINOR,PANEL_VERSION_PATCH,0
 PRODUCTVERSION PANEL_VERSION_MAJOR,PANEL_VERSION_MINOR,PANEL_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "VPforce"
            VALUE "FileDescription",  "TelemFFB settings and monitor panel for X-Plane"
            VALUE "FileVersion",      PANEL_VERSION
            VALUE "InternalName",     "TelemFFB-Panel"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Micah Frisby. GPL v3."
            VALUE "OriginalFilename", "win.xpl"
            VALUE "ProductName",      "TelemFFB Panel"
            VALUE "ProductVersion",   PANEL_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
